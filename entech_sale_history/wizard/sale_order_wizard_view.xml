<odoo>
    <record id="sale_order_wizard_form" model="ir.ui.view">
        <field name="name">sale_order_wizard_form</field>
        <field name="model">sale.order.wizard</field>

        <field name="arch" type="xml">

            <form>
                <group>
                    <field name="product_id"/>
                    <field name="customer_id"/>
                </group>
                <notebook>
                        <page string="Order History">
                                <field name="history_line_ids">
                                        <list editable="bottom">
                                                <field name="date_order"/>
                                                <field name="product_name"/>
                                                <field name="price"/>
                                                <field name="Customer_Purchase"/>
                                                <field name="order_name"/>
                                        </list>
                                </field>
                        </page>
                </notebook>





                <footer>

                    <button string="Close" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>





</odoo>