<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_line_inherit_tree_view" model="ir.ui.view">
        <field name="name">sale.order.line.view.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="after">
                <button name="action_view_product_history" type="object" string="History" class="oe_highlight" />
            </xpath>
        </field>
    </record>
</odoo>