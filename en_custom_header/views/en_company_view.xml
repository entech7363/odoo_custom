<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="company_form_inherit" model="ir.ui.view">
        <field name="name">res.company.form.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="website" position="after">
                <field name="report_header_image" widget="image" class="oe_avatar"
                       options="{'no_open': True, 'no_create': True, 'delete': true}"/>
            </field>
        </field>
    </record>
    <record id="view_company_form_custom_footer" model="ir.ui.view">
    <field name="name">res.company.footer.image</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='report_header_image']" position="after">
            <field name="report_footer_image" widget="image" class="oe_avatar" options="{'preview_image': 'report_footer_image'}"/>
        </xpath>
    </field>
    </record>

</odoo>
