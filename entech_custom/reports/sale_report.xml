<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_report_inherit" inherit_id="sale.report_saleorder_document">


        <xpath expr="//div[@class='row mb-4']//div[.//strong[text()='Salesperson']]" position="after">
            <t t-set="o" t-value="docs[0]"/>

            <div t-if="o.Customer_Purchase" class="col" name="info_customer_purchase">
                <strong>PO Number</strong>
                <div t-esc="o.Customer_Purchase"/>
            </div>
            <div t-if="o.Customer_Purchase_date" class="col" name="info_customer_purchase_date">
                <strong>PO Date</strong>
                <div t-esc="o.Customer_Purchase_date"/>
            </div>
        </xpath>


        <xpath expr="//div[@class='row mb-4']//div[.//strong[text()='Order Date']]" position="inside">
            <t t-set="o" t-value="docs[0]"/>
            <t t-if="o.picking_policy">
                <br/>
                <strong>Shipping Policy</strong>
                <div t-esc="o.picking_policy"/>
            </t>
        </xpath>
        <xpath expr="//div[@class='row mb-4']//div[.//strong[text()='Salesperson']]" position="inside">
            <t t-set="o" t-value="docs[0]"/>
            <t t-if="o.Customer_Delivery">
                <br/>
                <strong>Place of Delivery</strong>
                <div t-esc="o.Customer_Delivery"/>
            </t>
        </xpath>
    </template>
</odoo>
