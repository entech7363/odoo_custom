<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_invoices_document" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@class='row mb-4']" position="after">
            <t t-set="o" t-value="docs[0]"/>
                <!--<div class="row mb-4" id="Customer_fields">
                    <div t-if="o.Customer_RFQ" class="col" name="Customer_RFQ_info">
                        <strong>RFQ</strong>
                        <div t-esc="o.Customer_RFQ"/>
                    </div>
                    <div t-if="o.Customer_RFQ_date" class="col" name="Customer_RFQ_date_info">
                        <strong>RFQ Date</strong>
                        <div t-esc="o.Customer_RFQ_date"/>
                    </div>-->
               <div class="row mb-4" id="Purchase_fields">
                    <div t-if="o.Customer_Purchase" class="col" name="info_customer_purchase">
                            <strong>PO Number</strong>
                            <div t-esc="o.Customer_Purchase"/>
                    </div>

                    <div t-if="o.Customer_Purchase_date" class="col" name="info_customer_purchase_date">
                            <strong>PO Date</strong>
                            <div t-esc="o.Customer_Purchase_date.strftime('%d/%m/%Y')"/>
                    </div>

                    <div t-if="o.invoice_payment_term_id" class="col" name="info_customer_purchase_date">
                        <strong>Payment terms</strong>
                        <div t-esc="o.invoice_payment_term_id.name"/>


                    </div>
                    <div t-if="o.invoice_line_ids.sale_line_ids.order_id.picking_ids" class="col" name="info_customer_purchase_date">
                            <strong>Delivery Note:</strong><br/>
                            <t t-foreach="o.invoice_line_ids.sale_line_ids.order_id.picking_ids" t-as="picking">
                             <t t-esc="picking.name"/>

                    </t>




                    </div>


               </div>


                <!--<div class="row mb-4" id="Delivery_fields">
                    <div t-if="o.Customer_Delivery" class="col" name="info_customer_delivery">
                            <strong>Delivery</strong>
                            <div t-esc="o.Customer_Delivery"/>
                    </div>-->


                    <!--<div t-if="o.Customer_Number" class="col" name="info_customer_number" style="margin-left:0px;">
                            <strong>Delivery Number</strong>
                            <div t-esc="o.Customer_Number"/>
                    </div>
                    <div t-if="o.Customer_Number" class="col" name="info_customer_number" style="margin-left:0px;">


                    </div>
                    <div t-if="o.Customer_Number" class="col" name="info_customer_number" style="margin-left:0px;">

                    </div>-->


        </xpath>
        <xpath expr="//div[@class='mb-3']" position="replace">
            <div style="font-size:15px; padding15px;border:1px solid black;margin-top:30px;">
            <span>
                    <strong>Amount in Words (Total) :</strong>
                </span>
                <span t-field="o.number_to_words"/>
            </div>
        </xpath>
        <xpath expr="//div[@class='col']//strong[normalize-space(text())='Source']" position="replace">
            <strong>Quote Ref</strong>
        </xpath>

        <xpath expr="//div[@name='address_same_as_shipping']//address" position="replace">
            <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
            <div style="width: 48%; float: right; text-align: left; margin-right: 30px; margin-bottom: 30px;">

                <span t-esc="o.user_id.name"/></div>
            <div style="width: 58%; margin-left: -500px; margin-bottom: 10px;align-items: flex-start;  justify-content: space-between ">
                 <strong>
                                <span t-esc="o.partner_id.name"/>
                            </strong>
                  <div t-field="o.partner_id"
                             t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/><br/>
                        <p t-if="o.partner_id.vat">
                            <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                               t-out="o.company_id.account_fiscal_country_id.vat_label"/>

                        </p>

            </div></div>



                </xpath>






    </template>


</odoo>
