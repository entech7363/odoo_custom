<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="receipt_order_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@name='div_sched_date']" position="after">
            <t t-set="o" t-value="docs[0]"/>

            <div class="row">
                <div t-if="o.Order_Number" class="col-3" name="Order_Number_info">
                    <strong>SO Number</strong>
                    <div t-esc="o.Order_Number"/>
                </div>
                <div t-if="o.Order_Date" class="col-3" name="Order_Date_info">
                    <strong>SO Date</strong>
                    <div t-esc="o.Order_Date"/>
                </div>
            </div>

        </xpath>


    </template>
</odoo>

