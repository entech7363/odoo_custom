<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="purchase_order_document" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@class='row mb-4']" position="after">
            <t t-set="o" t-value="docs[0]"/>
                <div class="row mb-4" id="Vendor_fields" >
                    <div t-if="o.Quotation_number" class="col" name="Quotation_number_info">
                        <strong>Quotation Number</strong>
                        <div t-esc="o.Quotation_number"/>
                    </div>


                    <div t-if="o.Order_Number" class="col" name="Order_Number_info">
                        <strong>Order Number</strong>
                        <div t-esc="o.Order_Number"/>
                    </div>
                    <div t-if="o.Customer_Delivery" class="col" name="info_customer_delivery">
                            <strong>Place of Delivery</strong>
                            <div t-esc="o.Customer_Delivery"/>
                    </div>
                    <!--<div t-if="o.Delivery_Type " class="col" name="Delivery_Type _info">
                        <strong>Delivery Type </strong>
                        <div t-esc="o.Delivery_Type "/>
                    </div>

                    <div t-if="o.Reference_Number" class="col" name="Reference_Number_info">
                        <strong>Reference Number</strong>
                        <div t-esc="o.Reference_Number"/>
                    </div>-->
                </div>
                <div class="row mb-4" id="details">

                    <div t-if="o.Quotation_date" class="col" name="Quotation_date_info">
                        <strong>Quotation Date</strong>
                        <div t-esc="o.Quotation_date.strftime('%d/%m/%Y')"/>
                    </div>
                    <div t-if="o.Order_Date" class="col" name="Order_Date_info">
                        <strong>Date</strong>
                        <div t-esc="o.Order_Date.strftime('%d/%m/%Y')"/>
                    </div>
                    <div t-if="o.Order_Date" class="col" name="Order_Date_info">

                    </div>




                    <!--<div t-if="o.Receipt_Number " class="col" name="Receipt_Number_info">
                        <strong>Receipt Number </strong>
                        <div t-esc="o.Receipt_Number "/>
                    </div>
                    <div t-if="o.Receipt_Number " class="col" name="Receipt_Number_info">

                    </div>-->


                </div>
        </xpath>
        <xpath expr="//div[@id='informations']/div[@t-if='o.partner_ref']" position="inside">
            <div style="margin-top:48px;">
             <strong>Vendor Ref</strong><br/>
                <span t-esc="o.partner_ref"/></div>

        </xpath>

        <xpath expr="//div[@id='informations']/div[@t-if='o.partner_ref']//strong[normalize-space(text())='Your Order Reference']" position="replace">
            <strong>Our Ref</strong><br/>




        </xpath>
        <xpath expr="//div[@id='informations']//div[@t-if='o.date_planned']" position="before">
            <strong>Payment Terms </strong><br/>
            <span t-field="o.payment_term_id"></span><br/><br/><br/><strong>Incoterm</strong><br/><span t-esc="o.incoterm_id.code"/>

        </xpath>
        <xpath expr="//t[@t-set='information_block']" position="replace"/>
        <xpath expr="//div[@class='mt-4']" position="replace"/>
         <xpath expr="//t[@t-set='address']" position="before">
            <span>
                <h2 style="text-align:center;font-size:30px;margin-top:0px;">
                    <u>
                        <span t-if="o.state in ['draft', 'sent', 'to approve']">Request for Quotation</span>
                        <span t-elif="o.state in ['purchase', 'done']">Purchase Order</span>
                        <span t-else="o.state == 'cancel'">Cancelled Purchase Order</span>
                    </u>
                </h2>
            </span></xpath>

        <xpath expr="//t[@t-set='address']" position="replace">
            <span>
                <h2 style="text-align:center;font-size:30px;margin-top:0px;visibility:hidden;">
                    <u>
                        <span t-if="o.state in ['draft', 'sent', 'to approve']">Request for Quotation</span>
                        <span t-elif="o.state in ['purchase', 'done']">Purchase Order</span>
                        <span t-else="o.state == 'cancel'">Cancelled Purchase Order</span>

                    </u>
                </h2>
            </span>
            <div style=" float: right;text-align:left;margin-right: 100px;">
                <span>

                        <strong>Bill To</strong>
                            <div t-field="o.company_id.partner_id"
                                t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"],
                                    "no_marker": True, "phone_icons": True}'/>
                </span>
            </div>
            <div>
                <strong>Vendor</strong>
                <div t-field="o.partner_id"
                     t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"],
                 "no_marker": True, "phone_icons": True}'/>
            </div>
            <div style="text-align:right; margin-top: 70px;margin-right:30px;"><h2>
         <t t-if="o.state in ['draft', 'sent', 'to approve']">
            Request for Quotation #<span t-field="o.name"/>
        </t>
        <t t-elif="o.state in ['purchase', 'done']">
            Purchase Order #<span t-field="o.name"/>
        </t>
        <t t-else="">
            Cancelled Purchase Order #<span t-field="o.name"/>
        </t></h2>
    </div>
        </xpath>
        <xpath expr="//div[@class='page']/span[@t-field='o.payment_term_id']" position="replace"/>
        <xpath expr="//div[@class='page']//strong[normalize-space(text())='Payment Terms:']" position="replace">
            <div style="page-break-inside: avoid">


            <strong>Shipping Address</strong><br/>
            <div t-field="o.company_id.partner_id"
                                t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"],
                                    "no_marker": True, "phone_icons": True}'/><br/>
            <strong>Prepared by</strong>
            <div style="margin-left:40px;text-align:right;margin-top:10px;">
                <strong>Approved by</strong><br/>
                <strong>Purchase Manager</strong>

            </div>
            <div style="text-align:centre; margin-left:270px;">
                <strong>Computer generated document. No signature is required</strong>
            </div></div>


        </xpath>

        <xpath expr="//div[@id='informations']//div[@t-if=&quot;o.state in ['purchase','done'] and o.date_approve&quot;]" position="inside">
            <div style="margin-top:48px"><strong>Expected Arrival</strong>
                    <p t-field="o.date_planned" t-options="{'date_only': 'true'}"/></div>
        </xpath>

         <xpath expr="//div[@id='informations']//div[@t-if='o.date_planned']" position="replace"/>


        <xpath expr="//div[@t-if='o.incoterm_id']" position="replace"/>






    </template>



</odoo>
