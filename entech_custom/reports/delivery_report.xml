<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="stock_picking_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@name='div_sched_date']" position="before">
            <t t-set="o" t-value="docs[0]"/>

                    <div class="col col-3 mw-100 mb-2" id="Delivery_fields">
                            <div t-if="o.sale_id.Customer_Delivery" class="col" name="info_customer_delivery">
                                    <strong>Place of Delivery</strong>
                                    <div t-esc="o.sale_id.Customer_Delivery"/>
                            </div>
                    </div>
        </xpath>
        <xpath expr="//div[@name='div_sched_date']" position="after">
            <t t-set="o" t-value="docs[0]"/>
                <!--<div class="col col-3 mw-100 mb-2" id="Customer_fields">
                    <div t-if="o.Customer_RFQ" class="col" name="Customer_RFQ_info">
                        <strong>RFQ</strong>
                        <div t-esc="o.Customer_RFQ"/>
                    </div>
                </div>
                <div class="col col-3 mw-100 mb-2" id="Custom_fields">
                    <div t-if="o.Customer_RFQ_date" class="col" name="Customer_RFQ_date_info">
                        <strong>RFQ Date</strong>
                        <div t-esc="o.Customer_RFQ_date"/>
                    </div>
                </div>-->

                <div class="col col-3 mw-100 mb-2" id="purchase_fields">
                    <div t-if="o.Customer_Purchase" class="col" name="Customer_Purchase">
                        <strong>PO Number</strong>
                        <div t-esc="o.Customer_Purchase"/>
                    </div>
                </div>
                <div class="col col-3 mw-100 mb-2" id="purchasing_fields">
                    <div t-if="o.Customer_Purchase_date" class="col" name="Customer_Purchase_date">
                        <strong>PO Date</strong>
                        <div t-esc="o.Customer_Purchase_date.strftime('%d/%m/%Y')"/>
                    </div>

                </div>
                <div class="col col-3 mw-100 mb-2" id="payment_fields">
                        <div t-if="o.sale_id.payment_term_id" class="col">
                        <strong>Payment Terms</strong><br/>
                        <span t-esc="o.sale_id.payment_term_id.name"/>
                        </div></div>


                <!--<div class="col col-3 mw-100 mb-2" id="Deliver_fields">
                    <div t-if="o.Customer_Number" class="col" name="info_customer_number">
                            <strong>Delivery Number</strong>
                            <div t-esc="o.Customer_Number"/>
                    </div>
                </div>-->





        </xpath>



        <xpath expr="//div[hasclass('page')]" position="after">
             <div style="height: 30px;"></div>
            <div style="float: left; text-align:left;margin-top:100px;">
                <span>
                     <t t-if="o.remarks">

                        <div style="text-align: left;">
                        <strong>Remarks:</strong><br/>
                        <span t-field="o.remarks"/><br/>
                        </div><br/></t>



                    <strong>Received in good condition</strong><br/>
                    <strong>Name:</strong><br/>
                    <strong>Signature:</strong><br/>
                    <strong>Phone Number:</strong></span>



            </div>


            <div style="float: right; text-align: right;margin-top:170px;">

                             <span>
    <strong>For <t t-esc="o.company_id.name"/></strong>
</span>
                <br/><br/>
                <span>____________________________</span>
                <br/>
                <span>
                    <strong>Authorized Signature:</strong>
                </span>
            </div>


        </xpath>
        <xpath expr="//div[@class='col col-3 mw-100 mb-2']//strong[normalize-space(text())='Order']" position="replace">
            <strong>Quote Ref</strong>

        </xpath>
       <xpath expr="//t[@t-set='address']" position="replace">
            <div>
                <t t-if="o.picking_type_id.code=='incoming' or o.picking_type_id.code == 'internal'">
                    <h2 style="text-align:center;font-size:30px">
                        <strong>Goods Receipt Note</strong>
                    </h2>
                </t>
                <t t-if="o.picking_type_id.code=='outgoing'">
                    <h2 style="text-align:center;font-size:30px">
                        <strong>Delivery Note</strong>
                    </h2>
                </t>
            </div>

            <div>

<!--                <span>-->
<!--                    <strong>Buyer(Bill To):</strong>-->
<!--                    <br/>-->
<!--                </span>-->
                <t t-if="o.partner_id.company_type== 'person'">
                <div name="div_outgoing_address" style="margin-right:500px;">
                    <div name="outgoing_delivery_address"
                         t-if="o.should_print_delivery_address()">
                        <span>
                            <strong>Delivery Address:</strong>
                        </span>
                        <div t-field="o.move_ids[0].partner_id"
                             t-options='{"widget": "contact",  "fields": ["address"], "phone_icons": True,"email_icons": True}'/><br/>
                    </div>
                    <div name="outgoing_warehouse_address"
                         t-elif="o.picking_type_id.code != 'internal' and o.picking_type_id.warehouse_id.partner_id">
                        <span>
                            <strong>Warehouse Address:</strong>
                        </span>
                        <div t-field="o.picking_type_id.warehouse_id.partner_id"
                             t-options='{"widget": "contact",  "fields": ["address"], "phone_icons": True,"email_icons": True}'/><br/>
                    </div>
                </div>
                </t>
                <t t-else="">
                    <div name="div_outgoing_address" style="margin-right:500px;width:30%">
                        <div name="outgoing_delivery_address"
                             t-if="o.should_print_delivery_address()">
                            <span>
                                <strong>Delivery Address</strong>
                            </span>
                            <div t-field="o.move_ids[0].partner_id"
                                 t-options='{"widget": "contact",  "fields": ["address", "name","phone"], "no-marker": True,"email_icons": True}'/>
                            <br/>
                        </div>
                        <div name="outgoing_warehouse_address"
                             t-elif="o.picking_type_id.code != 'internal' and o.picking_type_id.warehouse_id.partner_id">
                            <span>
                                <strong>Warehouse Address:</strong>
                            </span>
                            <div t-field="o.picking_type_id.warehouse_id.partner_id"
                                 t-options='{"widget": "contact",  "fields": ["address""address", "name"], "phone_icons": True,"email_icons": True}'/>
                            <br/>
                        </div>
                    </div>

                </t>
                <div name="div_incoming_address" style="margin-right:500px;">
                    <t t-set="show_partner" t-value="False"/>
                    <div name="vendor_address" t-if="o.picking_type_id.code=='incoming' and partner">
                        <span>
                            <strong>Vendor Address:</strong>
                        </span>
                        <t t-set="show_partner" t-value="True"/>
                    </div>
<!--                    <div name="customer_address"-->
<!--                         t-if="o.picking_type_id.code=='outgoing' and partner and partner != partner.commercial_partner_id">-->
<!--                        <span>-->
<!--                            <strong>Customer Address:</strong>-->
<!--                        </span>-->
<!--                        <t t-set="show_partner" t-value="True"/>-->
<!--                    </div>-->
<!--                    <div t-if="show_partner" name="partner_header">-->
<!--                        <div t-field="partner.commercial_partner_id"-->
<!--                             t-options='{"widget": "contact",  "fields": ["address", "name","phone","mobile","email"], "phone_icons": True,"email_icons": True}'/>-->
<!--                    </div>-->
                </div>
            </div>
        </xpath>
         <xpath expr="//div[@name='div_sched_date']" position="replace">
            <div t-if="o.state" class="col col-3 mw-100 mb-2" name="div_sched_date">
                <strong>Delivery Date</strong>
                <div t-if="o.state == 'done'" t-field="o.date_done" t-options='{"widget": "date"}' class="m-0"/>
                <div t-else="" t-field="o.scheduled_date" t-options='{"widget": "date"}' class="m-0"/>

            </div></xpath>
        <xpath expr="//div[@name='div_sched_date']" position="after">
    <div class="col col-3 mw-100 mb-2" name="div_salesperson">
        <strong>Salesperson</strong>
        <div t-esc="o.sale_id.user_id.name"/>
    </div>
</xpath>





    </template>
</odoo>