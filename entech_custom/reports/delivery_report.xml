<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="stock_picking_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@name='div_sched_date']" position="before">
            <t t-set="o" t-value="docs[0]"/>

                    <div class="col col-3 mw-100 mb-2" id="Delivery_fields">
                            <div t-if="o.sale_id.Customer_Delivery" class="col" name="info_customer_delivery">
                                    <strong>Place of Delivery</strong>
                                    <div t-esc="o.sale_id.Customer_Delivery"/>
                            </div>
                    </div>
        </xpath>
        <xpath expr="//div[@name='div_sched_date']" position="after">
            <t t-set="o" t-value="docs[0]"/>
                <!--<div class="col col-3 mw-100 mb-2" id="Customer_fields">
                    <div t-if="o.Customer_RFQ" class="col" name="Customer_RFQ_info">
                        <strong>RFQ</strong>
                        <div t-esc="o.Customer_RFQ"/>
                    </div>
                </div>
                <div class="col col-3 mw-100 mb-2" id="Custom_fields">
                    <div t-if="o.Customer_RFQ_date" class="col" name="Customer_RFQ_date_info">
                        <strong>RFQ Date</strong>
                        <div t-esc="o.Customer_RFQ_date"/>
                    </div>
                </div>-->

                <div class="col col-3 mw-100 mb-2" id="purchase_fields">
                    <div t-if="o.Customer_Purchase" class="col" name="Customer_Purchase">
                        <strong>PO Number</strong>
                        <div t-esc="o.Customer_Purchase"/>
                    </div>
                </div>
                <div class="col col-3 mw-100 mb-2" id="purchasing_fields">
                    <div t-if="o.Customer_Purchase_date" class="col" name="Customer_Purchase_date">
                        <strong>PO Date</strong>
                        <div t-esc="o.Customer_Purchase_date"/>
                    </div>

                </div>
                <div class="col col-3 mw-100 mb-2" id="payment_fields">
                        <div t-if="o.sale_id.payment_term_id" class="col">
                        <strong>Payment Terms</strong><br/>
                        <span t-esc="o.sale_id.payment_term_id.name"/>
                        </div></div>


                <!--<div class="col col-3 mw-100 mb-2" id="Deliver_fields">
                    <div t-if="o.Customer_Number" class="col" name="info_customer_number">
                            <strong>Delivery Number</strong>
                            <div t-esc="o.Customer_Number"/>
                    </div>
                </div>-->





        </xpath>



        <xpath expr="//div[hasclass('page')]" position="after">
             <div style="height: 30px;"></div>
            <div style="float: left; text-align:left;">
                <span>
                    <strong>Received in good condition</strong><br/>
                    <strong>Name:</strong><br/>
                    <strong>Signature:</strong><br/>
                    <strong>Phone Number:</strong></span>
                <div style="display: flex; justify-content: center; align-items: center; margin-bottom: 20px;margin-left: 400px;">
                        <div style="text-align: center;">
                        <strong class="text-uppercase fw-bold mb-0">NOTE</strong><br/>
                        <span t-field="o.note"/>
                        </div>
                </div>


            </div>


            <div style="float: right; text-align: right;">
                <span>
                    <strong>For Entech Industrial Supplies and Trading </strong>
                </span>
                <br/><br/>
                <span>____________________________</span>
                <br/>
                <span>
                    <strong>Authorized Signature:</strong>
                </span>
            </div>


        </xpath>
        <xpath expr="//div[@class='col col-3 mw-100 mb-2']//strong[normalize-space(text())='Order']" position="replace">
            <strong>Quote Ref</strong>

        </xpath>
         <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address">
                <div style="display: flex;">
                    <div style="width: 48%; float: right; text-align: left; margin-right: 30px; margin-bottom: 30px;">

                        <span t-esc="o.sale_id.user_id.name"/>
                    </div>
                </div>
                <div style="margin-left: -500px; margin-bottom: 10px; ">
                    <div name="div_outgoing_address" class="text-left">
                        <div name="outgoing_delivery_address" t-if="o.should_print_delivery_address()">
                        <span><strong>Delivery Address:</strong></span>
                        <div t-out="o.move_ids[0].partner_id or o.partner_id"
                        t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                        </div>
                        </div>
                </div>
            </t>
         </xpath>



    </template>
</odoo>