<?xml version="1.0" encoding='utf-8'?>
<odoo>
    <record id="account_move_customer_view" model="ir.ui.view">
        <field name="name">account.move.form.view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
                <xpath expr="//group[@name='utm_link']" position="before">
                    <group string="Customer" invisible="move_type !='out_invoice'">
                        <field name="Customer_RFQ"/>
                        <field name="Customer_RFQ_date"/>
                        <field name="Customer_Purchase"/>
                        <field name="Customer_Purchase_date"/>
                        <field name="Customer_Delivery"/>
                        <field name="Customer_Number"/>

                    </group>
                </xpath>

        </field>



    </record>
    <record id="account_move_vendor_view" model="ir.ui.view">
        <field name="name">account.move.bills.form.view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
                <xpath expr="//group[@id='other_tab_group']" position="inside">
                    <group string="Vendor" invisible="move_type =='out_invoice'">
                        <field name="Quotation_number"/>
                        <field name="Quotation_date"/>
                        <field name="Order_Number"/>
                        <field name="Order_Date"/>
                        <field name="Reference_Number"/>
                        <field name="Delivery_Type"/>
                        <field name="Receipt_Number"/>

                    </group>
                </xpath>
        </field>

    </record>

</odoo>
