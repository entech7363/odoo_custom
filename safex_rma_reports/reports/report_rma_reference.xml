<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_rma_reference_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="address">
            <strong>Dealer</strong>
            <div t-field="doc.partner_id"
                 t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"], "no_marker": True}'/>
        </t>
        <t t-set="layout_document_title">
            <span>Repair Maintenance Authorisation</span>
        </t>
        <!-- web.external_layout takes letterhead, address and footer from `company`: use the
             branding company of the RMA's company (e.g. SafeX UK for SafeX Qatar), CR-05. -->
        <t t-set="company" t-value="doc._get_document_company()"/>
        <t t-call="web.external_layout">
            <div class="page">
                <div class="row mb-3">
                    <div class="col-6">
                        <h4 t-field="doc.name"/>
                        <div><strong>Ship to: </strong><span t-field="doc.company_id.partner_id"
                             t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/></div>
                    </div>
                    <div class="col-6 text-end">
                        <div t-field="doc.name"
                             t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 600, 'height': 100, 'img_style': 'width:300px;height:50px;'}"/>
                        <div t-if="doc.submitted_date"><strong>Submitted: </strong><span t-field="doc.submitted_date"/></div>
                    </div>
                </div>

                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: 30%;">Device Model / Serial Number</th>
                            <th style="width: 40%;">Reported Fault</th>
                            <th style="width: 25%;">Accessories Sent</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- CR-06: the model is printed once, each unit (serial / IMEI) on its own row
                             with its reported fault and accessories on the same row. -->
                        <t t-set="unit_number" t-value="0"/>
                        <t t-foreach="doc._get_lines_by_product()" t-as="group">
                            <tr class="bg-light">
                                <td/>
                                <td colspan="3"><strong t-out="group[0].name"/>
                                    <span t-if="len(group[1]) &gt; 1"> (<t t-out="len(group[1])"/> units)</span>
                                </td>
                            </tr>
                            <tr t-foreach="group[1]" t-as="line">
                                <t t-set="unit_number" t-value="unit_number + 1"/>
                                <td><t t-out="unit_number"/></td>
                                <td class="ps-3">
                                    <div class="small">S/N: <span t-field="line.lot_id.name"/></div>
                                    <div t-if="line.imei_1" class="small">IMEI 1: <span t-field="line.imei_1"/></div>
                                    <div t-if="line.imei_2" class="small">IMEI 2: <span t-field="line.imei_2"/></div>
                                </td>
                                <td><span t-field="line.complaint_description"/></td>
                                <td>
                                    <t t-set="accessories" t-value="doc.get_accessory_labels(line, 'acc_declared')"/>
                                    <span t-foreach="accessories" t-as="acc" class="badge text-bg-light me-1" t-out="acc"/>
                                    <span t-if="not accessories">None</span>
                                    <div t-if="line.acc_declared_battery_sno" class="small">Battery S/N: <span t-field="line.acc_declared_battery_sno"/></div>
                                    <div t-if="line.acc_declared_dock_sno" class="small">Dock S/N: <span t-field="line.acc_declared_dock_sno"/></div>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <h6 class="mt-4">Physical Intake Inspection (SafeX Workshop)</h6>
                <p>
                    [ ] Box seal intact &#160;&#160; [ ] Physical damage upon arrival (photos taken)
                    &#160;&#160; [ ] Accessory count verified against manifest
                </p>

                <div t-if="doc.terms" class="mt-4 small" style="page-break-inside: avoid;">
                    <h6>RMA Terms &amp; Conditions</h6>
                    <div t-field="doc.terms"/>
                </div>

                <div class="mt-5" style="page-break-inside: avoid;">
                    <h6>Received by</h6>
                    <div class="row mt-3">
                        <div class="col-4">Name: ______________________</div>
                        <div class="col-4">Signature: ______________________</div>
                        <div class="col-4">Date: ______________________</div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_rma_reference">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="safex_rma_reports.report_rma_reference_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>
