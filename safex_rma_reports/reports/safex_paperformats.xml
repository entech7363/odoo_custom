<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Same geometry as the paperformat of the invoices (A4, 35/25/7/7 mm, header spacing 38, 90 dpi):
         the letterhead image of en_custom_header (report_header_image, full width) needs the 35 mm top
         margin and 38 mm header spacing so that the body starts below it on every page, and the
         footer image needs the 25 mm bottom margin to be printed entirely. -->
    <record id="paperformat_safex_a4" model="report.paperformat">
        <field name="name">SafeX A4</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">38</field>
        <field name="dpi">90</field>
    </record>

</odoo>
