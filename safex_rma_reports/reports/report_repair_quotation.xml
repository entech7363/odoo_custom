<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_repair_quotation_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="address">
            <div t-field="doc.partner_id"
                 t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
        </t>
        <t t-set="layout_document_title">
            <span>Repair Quotation # </span><span t-field="doc.name"/>
        </t>
        <!-- D1 / CR-05: letterhead, address and footer of the RMA documents branding company. -->
        <t t-set="company" t-value="doc._get_safex_document_company() or doc.company_id.sudo()"/>
        <t t-call="web.external_layout">
            <div class="page o_safex_report">
                <div class="row mb-3">
                    <div class="col"><strong>RMA</strong><div t-field="doc.rma_id.name"/></div>
                    <div class="col"><strong>Date</strong><div t-field="doc.date_order" t-options='{"widget": "date"}'/></div>
                    <div class="col" t-if="doc.client_order_ref"><strong>PO Number</strong><div t-field="doc.client_order_ref"/></div>
                </div>

                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th style="width: 55%;">Description</th>
                            <th style="width: 13%;" class="text-end">Quantity</th>
                            <th style="width: 16%;" class="text-end">Unit Price</th>
                            <th style="width: 16%;" class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- CR-06: the device model is printed once, each unit's serial number / IMEI
                             beneath it, followed by that unit's lines and subtotal. -->
                        <t t-set="grouped" t-value="doc._get_safex_grouped_lines()"/>
                        <t t-foreach="grouped[0]" t-as="group">
                            <tr class="bg-light fw-bold">
                                <td colspan="4"><span t-out="group['product'].display_name"/>
                                    <span t-if="len(group['units']) &gt; 1" class="fw-normal"> (<t t-out="len(group['units'])"/> units)</span>
                                </td>
                            </tr>
                            <t t-foreach="group['units']" t-as="unit">
                                <t t-set="device" t-value="unit['device']"/>
                                <tr class="fw-bold">
                                    <td colspan="4" class="ps-3">
                                        S/N: <span t-out="device.lot_id.name"/>
                                        <span t-if="device.imei_1"> &#160;|&#160; IMEI: <span t-out="device.imei_1"/></span>
                                        <span t-if="device.imei_2"> &#160;|&#160; IMEI 2: <span t-out="device.imei_2"/></span>
                                    </td>
                                </tr>
                                <tr t-foreach="unit['lines']" t-as="line">
                                    <td class="ps-4">
                                        <!-- The spare part line name already carries
                                             "[Replaced Part - Cost Absorbed in Service Charge]". -->
                                        <span t-field="line.name"/>
                                    </td>
                                    <td class="text-end"><span t-field="line.product_uom_qty"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                </tr>
                                <tr class="fw-bold">
                                    <td colspan="3" class="text-end">Device Subtotal</td>
                                    <td class="text-end">
                                        <span t-out="sum(unit['lines'].mapped('price_subtotal'))"
                                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                        <t t-foreach="grouped[1]" t-as="line">
                            <tr t-if="line.display_type == 'line_note'" class="fst-italic">
                                <td colspan="4"><span t-field="line.name"/></td>
                            </tr>
                            <tr t-else="">
                                <td><span t-field="line.name"/></td>
                                <td class="text-end"><span t-field="line.product_uom_qty"/></td>
                                <td class="text-end"><span t-field="line.price_unit"/></td>
                                <td class="text-end"><span t-field="line.price_subtotal"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="row justify-content-end">
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr><td>Untaxed Amount</td><td class="text-end"><span t-field="doc.amount_untaxed"/></td></tr>
                            <tr><td>Taxes</td><td class="text-end"><span t-field="doc.amount_tax"/></td></tr>
                            <tr class="fw-bold"><td>Grand Total</td><td class="text-end"><span t-field="doc.amount_total"/></td></tr>
                        </table>
                    </div>
                </div>

                <div class="mt-4 p-2 border" style="page-break-inside: avoid;">
                    <strong>Single PO Acceptance</strong>
                    <p class="mb-2">One single PO number covers the grand total of all devices in this RMA.</p>
                    <div class="row">
                        <div class="col-3">PO Number: __________</div>
                        <div class="col-3">Signature: __________</div>
                        <div class="col-3">Stamp: __________</div>
                        <div class="col-3">Date: __________</div>
                    </div>
                </div>

                <div t-if="doc.note" class="mt-4 small" style="page-break-inside: avoid;">
                    <h6>Terms &amp; Conditions</h6>
                    <div t-field="doc.note"/>
                </div>
            </div>
        </t>
    </template>

    <template id="report_repair_quotation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="safex_rma_reports.report_repair_quotation_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>
