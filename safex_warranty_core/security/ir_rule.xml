<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Allowed Companies (safex_company_ids): a product / category / serial restricted to some
         companies is hidden from the other companies, e.g. the SafeX shared devices (Company empty,
         Allowed Companies = SafeX Qatar + SafeX UK) are not visible in Entech.
         Empty Allowed Companies = standard Odoo company rules only. -->

    <record id="rule_product_template_safex_companies" model="ir.rule">
        <field name="name">Product Template: Allowed Companies</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('safex_company_ids', '=', False), ('safex_company_ids', 'in', company_ids)]</field>
    </record>

    <record id="rule_product_product_safex_companies" model="ir.rule">
        <field name="name">Product Variant: Allowed Companies</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('product_tmpl_id.safex_company_ids', '=', False), ('product_tmpl_id.safex_company_ids', 'in', company_ids)]</field>
    </record>

    <record id="rule_product_category_safex_companies" model="ir.rule">
        <field name="name">Product Category: Allowed Companies</field>
        <field name="model_id" ref="product.model_product_category"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('safex_company_ids', '=', False), ('safex_company_ids', 'in', company_ids)]</field>
    </record>

    <record id="rule_stock_lot_safex_companies" model="ir.rule">
        <field name="name">Lot/Serial: Allowed Companies of the product</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('product_id.product_tmpl_id.safex_company_ids', '=', False), ('product_id.product_tmpl_id.safex_company_ids', 'in', company_ids)]</field>
    </record>

</odoo>
