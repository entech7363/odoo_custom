<odoo>
    <record id="view_company_form_reapproval" model="ir.ui.view">
        <field name="name">res.company.form.reapproval</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="po_reapproval_enabled"/>
            </xpath>
        </field>
    </record>
</odoo>
