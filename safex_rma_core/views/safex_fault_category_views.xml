<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_safex_fault_category_list" model="ir.ui.view">
        <field name="name">safex.fault.category.list</field>
        <field name="model">safex.fault.category</field>
        <field name="arch" type="xml">
            <list string="Fault Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_safex_fault_category_search" model="ir.ui.view">
        <field name="name">safex.fault.category.search</field>
        <field name="model">safex.fault.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_safex_fault_category" model="ir.actions.act_window">
        <field name="name">Fault Categories</field>
        <field name="res_model">safex.fault.category</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a fault category</p>
            <p>Technicians tag every diagnosed device with one or more fault categories.</p>
        </field>
    </record>

</odoo>
