<odoo>
   <data>


       <!-- Inherit the invoice report template -->
       <template id="custom_add_serial_fields_invoice" inherit_id="account.report_invoice_document">

          <xpath expr="//table[@name='invoice_snln_table']" position="attributes">
    <attribute name="style">width: 100%;</attribute>
</xpath>


          <!-- TABLE HEADER -->
      <xpath expr="//table[@name='invoice_snln_table']/thead/tr/th[last()]" position="after">
        <t t-if="any(l.get('imei_no_1') for l in lot_values)">
          <th class="text-end"><span>IMEI No.1</span></th>
        </t>
        <t t-if="any(l.get('imei_no_2') for l in lot_values)">
          <th class="text-end"><span>IMEI No.2</span></th>
        </t>
        <t t-if="any(l.get('battery_sno') for l in lot_values)">
          <th class="text-end"><span>Battery SNO</span></th>
        </t>
        <t t-if="any(l.get('docking_station_sno') for l in lot_values)">
          <th class="text-end"><span>Docking Station SNO</span></th>
        </t>
      </xpath>

      <!-- TABLE BODY -->
      <xpath expr="//table[@name='invoice_snln_table']/tbody/tr/td[last()]" position="after">
        <t t-if="any(l.get('imei_no_1') for l in lot_values)">
          <td class="text-end"><t t-esc="snln_line.get('imei_no_1') or ''"/></td>
        </t>
        <t t-if="any(l.get('imei_no_2') for l in lot_values)">
          <td class="text-end"><t t-esc="snln_line.get('imei_no_2') or ''"/></td>
        </t>
        <t t-if="any(l.get('battery_sno') for l in lot_values)">
          <td class="text-end"><t t-esc="snln_line.get('battery_sno') or ''"/></td>
        </t>
        <t t-if="any(l.get('docking_station_sno') for l in lot_values)">
          <td class="text-end"><t t-esc="snln_line.get('docking_station_sno') or ''"/></td>
        </t>
      </xpath>
<!--           Added sale order date
        <xpath expr="//div[@name='origin']" position="after">
            <div class="col" t-if="o.sale_order_date" name="order_date">
                <strong>Order Date</strong>
                <div t-esc="o.sale_order_date.strftime('%Y-%m-%d')"/>
            </div>
        </xpath>-->


       </template>


   </data>




</odoo>
