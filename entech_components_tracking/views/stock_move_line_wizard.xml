<odoo>
    <data>
        <record id="view_stock_move_line_operation_tree_inherit_expiry" model="ir.ui.view">
            <field name="name">stock.move.line.operations.list.inherit</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lot_name']" position="after">

                    <!--                    <field name="show_battery_sno" invisible="1"/>-->
                    <!--                    <field name="show_docking_station_sno" invisible="1"/>-->
                    <field name="imei_no_1" column_invisible="parent.show_imei_fields == False"/>
                    <field name="imei_no_2" column_invisible="parent.show_imei_fields == False"/>
                    <field name="battery_sno" column_invisible="parent.show_battery_sno == False"/>
                    <field name="docking_station_sno" column_invisible="parent.show_docking_station_sno == False"/>

                </xpath>


            </field>
        </record>
    </data>
</odoo>
