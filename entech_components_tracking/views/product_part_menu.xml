<odoo>
<!-- form view-->
    <record id="view_product_part_form" model="ir.ui.view">
        <field name="name">product.part.form</field>
        <field name="model">product.part</field>
        <field name="arch" type="xml">
            <form string="Product Part">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
<!--list view-->
    <record id="view_product_part_tree" model="ir.ui.view">
            <field name="name">product.part.tree</field>
            <field name="model">product.part</field>
            <field name="arch" type="xml">
                <list string="Product Parts">
                    <field name="name"/>
                </list>
            </field>
        </record>

    <!-- Action -->
    <record id="action_product_part" model="ir.actions.act_window">
        <field name="name">Product Parts</field>
        <field name="res_model">product.part</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_product_part"
        name="Product Parts"
        parent="stock.menu_product_in_config_stock"
        action="action_product_part"
        sequence="60"
    />
</odoo>
