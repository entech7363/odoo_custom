<odoo>
  <data>

    <!-- Sale Order  -->
    <record id="sale_order_form_inherit_partner_type" model="ir.ui.view">
      <field name="name">sale.order.form.inherit.partner.type</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='partner_id']" position="attributes">
          <attribute name="context">{'default_partner_type': 'customer'}</attribute>
        </xpath>
      </field>
    </record>

    <!-- Purchase Order-->
    <record id="purchase_order_form_inherit_partner_type" model="ir.ui.view">
      <field name="name">purchase.order.form.inherit.partner.type</field>
      <field name="model">purchase.order</field>
      <field name="inherit_id" ref="purchase.purchase_order_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='partner_id']" position="attributes">
          <attribute name="context">{'default_partner_type': 'vendor'}</attribute>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
