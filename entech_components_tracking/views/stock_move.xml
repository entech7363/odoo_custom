<odoo>
    <record id="view_stock_move_operations_inherit_start_date" model="ir.ui.view">
        <field name="name">stock.move.operations.form.inherit.start.date</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//group[.//field[@name='product_id']]" position="replace">
                <group col="2">
                    <group>
                        <field name="product_id"/>
                        <field name="v_start_date" required="1" invisible="show_customer_warranty"/>
                        <label for="vendor_warranty" invisible="show_customer_warranty"/>
                        <div invisible="show_customer_warranty">
                            <field name="vendor_warranty" required="1" class="oe_inline" style="vertical-align:baseline"/>
                            Months
                        </div>
                        <field name="c_start_date" required="1" invisible="show_vendor_warranty"/>
                        <label for="customer_warranty" invisible="show_vendor_warranty"/>
                        <div invisible="show_vendor_warranty">
                            <field name="customer_warranty" required="1" class="oe_inline" style="vertical-align:baseline"/>
                            Months
                        </div>
                        <field name="product_uom_qty"/>
                        <field name="show_battery_sno" invisible="1"/>
                        <field name="show_docking_station_sno" invisible="1"/>
                        <field name="show_imei_no_1" invisible="1"/>
                        <field name="show_imei_no_2" invisible="1"/>

                    </group>

                    <group>
                        <field name="serial_no" widget="auto_tab_serial"/>
                        <field name="show_imei_form_no_1" invisible="1"/>
                        <field name="show_imei_form_no_2" invisible="1"/>
                        <field name="imei_no_1" invisible="not show_imei_form_no_1" widget="auto_tab_serial"/>
                        <field name="imei_no_2" invisible="not show_imei_form_no_2" widget="auto_tab_serial"/>

                        <field name="show_battery" invisible="1"/>
                        <field name="show_docking_station" invisible="1"/>
                        <field name="battery_sno" invisible="not show_battery" widget="auto_tab_serial"/>
                        <field name="docking_station_sno" invisible="not show_docking_station"
                               widget="auto_tab_serial"/>

                        <button name="action_transfer_serial_fields"
                                string="Next"
                                type="object"
                                class="btn-primary"
                                edit="true"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
