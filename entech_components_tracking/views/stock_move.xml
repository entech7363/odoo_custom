<odoo>
    <record id="view_stock_move_operations_inherit_start_date" model="ir.ui.view">
        <field name="name">stock.move.operations.form.inherit.start.date</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//group[.//field[@name='product_id']]" position="replace">
                <group col="2">
                    <group>
                        <field name="product_id"/>
                        <field name="v_start_date" invisible="show_customer_warranty"/>
                        <field name="vendor_warranty" invisible="show_customer_warranty"/>
                        <field name="c_start_date" invisible="show_vendor_warranty"/>
                        <field name="customer_warranty" invisible="show_vendor_warranty"/>
                        <field name="product_uom_qty"/>
                    </group>

                    <group>
<!--                        <field name="show_battery_sno"/>-->
<!--                       <field name="show_docking_station_sno"/>-->
                        <field name="serial_no"/>
                        <field name="imei_no_1"/>
                        <field name="imei_no_2"/>
                        <field name="battery_sno"/>
                        <field name="docking_station_sno"/>
                        <button name="action_transfer_serial_fields"
                                string="Next"
                                type="object"
                                class="btn-primary"
                                 edit="true"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
