<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_safex_quotation_terms" model="ir.ui.view">
        <field name="name">res.company.form.safex.quotation.terms</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="safex_rma_core.view_company_form_safex_rma"/>
        <field name="arch" type="xml">
            <group name="safex_warranty" position="after">
                <group name="safex_po_reminders" string="PO Pending Reminders">
                    <field name="safex_po_reminder_days" placeholder="7,14,30,40"/>
                    <div class="text-muted" colspan="2">
                        Days after the dealer's approval on which a PO reminder email is sent,
                        separated by commas. Leave empty to send no reminders.
                    </div>
                </group>
            </group>
            <page name="safex_settings" position="inside">
                <group name="safex_quotation_terms" string="Repair Quotation Terms &amp; Conditions">
                    <field name="safex_quotation_terms" nolabel="1" colspan="2"/>
                </group>
            </page>
        </field>
    </record>

</odoo>
