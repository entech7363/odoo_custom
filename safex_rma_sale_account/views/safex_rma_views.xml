<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_safex_rma_form_sale" model="ir.ui.view">
        <field name="name">safex.rma.form.sale</field>
        <field name="model">safex.rma</field>
        <field name="inherit_id" ref="safex_rma_core.view_safex_rma_form"/>
        <field name="arch" type="xml">
            <button name="action_complete_physical_inspection" position="after">
                <field name="has_quoted_lines" invisible="1"/>
                <button name="action_generate_quotation" type="object" string="Generate Quotation"
                        class="btn-primary" invisible="not has_quoted_lines"
                        groups="sales_team.group_sale_salesman"/>
                <button name="action_send_quotation" type="object" string="Send Quotation to Portal"
                        invisible="quotation_count == 0 or quote_sent_date"
                        groups="sales_team.group_sale_salesman"/>
                <button name="action_dealer_approve" type="object" string="Approve on Behalf of Dealer"
                        invisible="quotation_count == 0 or has_po_pending"
                        groups="sales_team.group_sale_salesman"
                        confirm="Approve the open quotation on behalf of the dealer?"/>
                <button name="action_create_invoice" type="object" string="Create Invoice"
                        invisible="state not in ('processing', 'dispatched', 'closed') or quotation_count == 0"
                        groups="account.group_account_invoice"/>
            </button>
            <div name="button_box" position="inside">
                <button name="action_view_quotations" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        invisible="quotation_count == 0">
                    <field name="quotation_count" widget="statinfo" string="Quotations"/>
                </button>
                <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                        invisible="invoice_count == 0">
                    <field name="invoice_count" widget="statinfo" string="Invoices"/>
                </button>
            </div>
            <field name="po_pending_since" position="after">
                <field name="po_pending_days" invisible="not po_pending_since"/>
                <field name="quote_sent_date"/>
                <field name="amount_total"/>
                <field name="currency_id" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="view_safex_rma_line_form_sale" model="ir.ui.view">
        <field name="name">safex.rma.line.form.sale</field>
        <field name="model">safex.rma.line</field>
        <field name="inherit_id" ref="safex_rma_core.view_safex_rma_line_form"/>
        <field name="arch" type="xml">
            <field name="is_chargeable" position="after">
                <field name="currency_id" invisible="1"/>
                <field name="service_charge_amount" invisible="not is_chargeable"
                       required="is_chargeable and state == 'quoted'"/>
            </field>
        </field>
    </record>

</odoo>
