<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_entech_mail" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.entech.mail</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='companies_setting_container']" position="after">
                <block title="Company Outgoing Email Sender" name="company_outgoing_mail_container">
                    <setting id="email_from_company_sale_setting"
                             company_dependent="1"
                             string="Sales Emails from Company"
                             help="Force outgoing quotation and order emails to use the company email as sender">
                        <field name="email_from_company_sale"/>
                    </setting>
                    <setting id="email_from_company_account_setting"
                             company_dependent="1"
                             string="Invoice Emails from Company"
                             help="Force outgoing invoice and credit note emails to use the company email as sender">
                        <field name="email_from_company_account"/>
                    </setting>
                    <setting id="email_from_company_purchase_setting"
                             company_dependent="1"
                             string="Purchase Emails from Company"
                             help="Force outgoing RFQ and purchase order emails to use the company email as sender">
                        <field name="email_from_company_purchase"/>
                    </setting>
                    <setting id="email_from_company_stock_setting"
                             company_dependent="1"
                             string="Delivery Emails from Company"
                             help="Force outgoing delivery slip emails to use the company email as sender">
                        <field name="email_from_company_stock"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
