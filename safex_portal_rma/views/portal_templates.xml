<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Home cards (DES00103): always shown, before the standard cards, so a new dealer sees where
         to verify a device and raise the first RMA even with no RMA yet. -->
    <template id="portal_my_home_safex_rma" name="Show RMA &amp; Repairs" inherit_id="portal.portal_my_home"
              customize_show="True" priority="30">
        <div id="portal_client_category" position="before">
            <div class="o_portal_category row g-2 mt-3" id="safex_rma_category">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/safex_portal_rma/static/src/img/rma.svg'"/>
                    <t t-set="title">RMA &amp; Repairs</t>
                    <t t-set="url" t-value="'/my/rma'"/>
                    <t t-set="text">Create and track repair requests, review quotations and enter PO numbers</t>
                    <t t-set="placeholder_count" t-value="'rma_count'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/safex_portal_rma/static/src/img/verify.svg'"/>
                    <t t-set="title">Verify a Device</t>
                    <t t-set="url" t-value="'/my/verify'"/>
                    <t t-set="text">Check a Serial Number and IMEI before raising an RMA</t>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </div>
        </div>
    </template>

    <template id="portal_breadcrumbs_safex_rma" name="Portal layout: RMA entries" inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'safex_rma'" class="breadcrumb-item active">RMA &amp; Repairs</li>
            <li t-if="page_name in ('safex_rma_detail', 'safex_rma_new')" class="breadcrumb-item">
                <a href="/my/rma">RMA &amp; Repairs</a>
            </li>
            <li t-if="page_name == 'safex_rma_detail'" class="breadcrumb-item active" t-out="rma.name"/>
            <li t-if="page_name == 'safex_rma_new'" class="breadcrumb-item active">New RMA</li>
            <li t-if="page_name == 'safex_verify'" class="breadcrumb-item active">Verify a Device</li>
        </xpath>
    </template>

    <template id="rma_state_badge" name="RMA State Badge">
        <t t-set="badge_class" t-value="{
            'submitted': 'text-bg-info', 'received': 'text-bg-info', 'inspection': 'text-bg-warning',
            'processing': 'text-bg-primary', 'dispatched': 'text-bg-success', 'closed': 'text-bg-secondary',
        }.get(state, 'text-bg-light')"/>
        <span t-attf-class="badge rounded-pill #{badge_class}" t-out="label"/>
    </template>

    <!-- RMA list -->
    <template id="portal_my_rmas" name="My RMAs">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">RMA &amp; Repairs</t>
            </t>
            <div class="d-flex justify-content-end gap-2 mb-3">
                <a href="/my/verify" class="btn btn-secondary">Verify a Device</a>
                <a href="/my/rma/new" class="btn btn-primary">New RMA</a>
            </div>
            <div t-if="not rmas" class="alert alert-info" role="alert">
                You have no RMA yet.
            </div>
            <t t-if="rmas" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>RMA #</th>
                        <th>Submitted</th>
                        <th>Received</th>
                        <th class="text-center">Devices</th>
                        <th>PO Number</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="rmas" t-as="rma">
                        <td>
                            <a t-att-href="rma.access_url" t-out="rma.name"/>
                            <span t-if="rma.dealer_received_date" class="badge rounded-pill text-bg-success ms-1">Received by Dealer</span>
                        </td>
                        <td><span t-field="rma.submitted_date" t-options="{'widget': 'date'}"/></td>
                        <td><span t-field="rma.received_date" t-options="{'widget': 'date'}"/></td>
                        <td class="text-center" t-out="rma.device_count"/>
                        <td>
                            <span t-if="rma.po_number" t-out="rma.po_number"/>
                            <span t-elif="rma.has_po_pending" class="badge text-bg-warning">PO Pending</span>
                        </td>
                        <td class="text-end">
                            <t t-call="safex_portal_rma.rma_state_badge">
                                <t t-set="state" t-value="rma.state"/>
                                <t t-set="label" t-value="dict(rma._fields['state']._description_selection(rma.env))[rma.state]"/>
                            </t>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <!-- New multi-device RMA -->
    <template id="portal_rma_new" name="New RMA">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">New RMA</t>
            </t>
            <div t-if="error == 'device'" class="alert alert-danger" role="alert">
                Every device must be verified and have a complaint description.
            </div>
            <div t-if="error == 'empty'" class="alert alert-danger" role="alert">
                Add at least one verified device.
            </div>
            <div t-if="error == 'duplicate'" class="alert alert-danger" role="alert">
                A device can only be added once, and cannot be on another RMA that is still open.
            </div>
            <div t-if="error == 'other_dealer'" class="alert alert-danger" role="alert">
                Device <strong t-out="error_serial"/> was sold through another dealer: remove it and add it
                again, then click "Proceed to RMA" to raise an RMA for it.
            </div>
            <div t-if="error == 'too_many'" class="alert alert-danger" role="alert">
                An RMA can hold at most 50 devices: please raise a separate RMA for the other devices.
            </div>
            <div t-if="error == 'throttled'" class="alert alert-danger" role="alert">
                Too many verification attempts. Please wait a minute and submit again.
            </div>
            <div t-if="error == 'mixed_company'" class="alert alert-danger" role="alert">
                These devices were sold to you by different SafeX companies (<strong t-out="error_serial"/>).
                Please raise a separate RMA for the devices of each company.
            </div>
            <div t-if="error == 'photo'" class="alert alert-danger" role="alert">
                Complaint photos must be images (JPG, PNG, ...) of at most 5 MB each, up to 5 photos per device.
            </div>
            <div t-if="error == 'accessory_serial_missing'" class="alert alert-danger" role="alert">
                Enter the serial number of every Battery and Docking Station you send.
            </div>
            <div t-if="error == 'battery_serial'" class="alert alert-danger" role="alert">
                Battery serial number <strong t-out="error_serial"/> was not found. Check the serial number
                printed on the battery and try again.
            </div>
            <div t-if="error == 'dock_serial'" class="alert alert-danger" role="alert">
                Docking Station serial number <strong t-out="error_serial"/> was not found. Check the serial
                number printed on the docking station and try again.
            </div>
            <div t-if="error and safex_devices" class="alert alert-info" role="status">
                The devices you entered have been kept below: correct the problem and submit again.
                Complaint photos must be selected again.
            </div>
            <form action="/my/rma/new" method="post" enctype="multipart/form-data" class="o_safex_rma_new_form"
                  t-att-data-safex-devices="safex_devices_json or '[]'">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Add a device</h5>
                        <p class="text-muted small">Each device is verified before it is added: enter its Serial Number and IMEI (IMEI 1 or IMEI 2).</p>
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label" for="safex_new_serial">Serial Number</label>
                                <input type="text" class="form-control" id="safex_new_serial"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="safex_new_imei">IMEI 1 or IMEI 2</label>
                                <input type="text" class="form-control" id="safex_new_imei"/>
                            </div>
                            <div class="col-md-4">
                                <button type="button" class="btn btn-secondary w-100 o_safex_add_device">Verify &amp; Add</button>
                            </div>
                        </div>
                        <div class="o_safex_verify_result mt-2"/>
                    </div>
                </div>

                <div class="o_safex_device_rows"/>

                <div class="d-none o_safex_device_template">
                    <div class="card mb-3 o_safex_device_card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <div>
                                <strong class="o_safex_device_title"/>
                                <span class="badge text-bg-warning ms-2 d-none o_safex_other_dealer_badge"/>
                            </div>
                            <button type="button" class="btn btn-sm btn-link text-danger o_safex_remove_device">Remove</button>
                        </div>
                        <div class="card-body">
                            <input type="hidden" name="device_index" class="o_safex_index"/>
                            <input type="hidden" data-name="serial"/>
                            <input type="hidden" data-name="imei"/>
                            <input type="hidden" data-name="other_dealer_confirmed"/>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label">Customer Name (optional)</label>
                                    <input type="text" class="form-control" data-name="customer_name"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Customer Company (optional)</label>
                                    <input type="text" class="form-control" data-name="customer_company"/>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Complaint Description</label>
                                    <textarea class="form-control" rows="2" data-name="complaint" data-required="1"/>
                                </div>
                                <div class="col-12">
                                    <label class="form-label d-block">Accessories sent</label>
                                    <t t-foreach="[('charger', 'Charger'), ('dock', 'Docking Station'), ('battery', 'Battery'), ('screwdriver', 'Screwdriver'), ('cable', 'Cable'), ('box', 'With Box')]" t-as="acc">
                                        <div class="form-check form-check-inline">
                                            <input type="checkbox" class="form-check-input" t-att-data-name="'acc_%s' % acc[0]" value="1"/>
                                            <label class="form-check-label" t-out="acc[1]"/>
                                        </div>
                                    </t>
                                    <div class="row g-2 mt-1">
                                        <div class="col-md-6 d-none o_safex_acc_sno" data-accessory="acc_battery">
                                            <label class="form-label">Battery Serial Number</label>
                                            <input type="text" class="form-control" data-name="acc_battery_sno"
                                                   placeholder="Serial number printed on the battery"/>
                                        </div>
                                        <div class="col-md-6 d-none o_safex_acc_sno" data-accessory="acc_dock">
                                            <label class="form-label">Docking Station Serial Number</label>
                                            <input type="text" class="form-control" data-name="acc_dock_sno"
                                                   placeholder="Serial number printed on the docking station"/>
                                        </div>
                                    </div>
                                    <input type="text" class="form-control mt-2" placeholder="Other accessories" data-name="acc_other"/>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Complaint Photos (optional, up to 5 images, 5 MB each)</label>
                                    <input type="file" class="form-control" data-name="photos" accept="image/*" multiple="multiple"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary o_safex_submit_rma" disabled="disabled">Submit RMA</button>
            </form>
        </t>
    </template>

    <!-- RMA detail -->
    <template id="portal_rma_detail" name="RMA Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title" t-value="rma.name"/>
            </t>

            <div t-if="message == 'created'" class="alert alert-success" role="alert">
                Your RMA has been submitted. Print the RMA Reference Document and place it inside the parcel.
            </div>
            <div t-if="message == 'po'" class="alert alert-success" role="alert">
                Your PO was sent to SafeX. Repair work starts as soon as SafeX has verified it.
            </div>
            <div t-if="message == 'approve'" class="alert alert-success" role="alert">Quotation approved. Please submit your PO.</div>
            <div t-if="message in ('reject', 'clarify')" class="alert alert-success" role="alert">Your request was sent to SafeX.</div>
            <div t-if="message == 'received'" class="alert alert-success" role="alert">Thank you. Receipt of the devices has been confirmed to SafeX.</div>
            <div t-if="error == 'po_file'" class="alert alert-danger" role="alert">
                The PO document must be a PDF or an image of at most 10 MB.
            </div>
            <div t-elif="error == 'po_file_missing'" class="alert alert-danger" role="alert">
                Attach the PO document (PDF or image) to submit your PO.
            </div>
            <div t-elif="error == 'po'" class="alert alert-danger" role="alert">
                The PO could not be submitted. Enter the PO number and attach the PO document.
            </div>
            <div t-elif="error" class="alert alert-danger" role="alert">
                The action could not be completed. A reason is mandatory to reject or ask for clarification.
            </div>

            <!-- Logistics & status banner -->
            <div class="card mb-3">
                <div class="card-body d-flex flex-wrap justify-content-between gap-3">
                    <div>
                        <h4 class="mb-1" t-out="rma.name"/>
                        <t t-call="safex_portal_rma.rma_state_badge">
                            <t t-set="state" t-value="rma.state"/>
                            <t t-set="label" t-value="dict(rma._fields['state']._description_selection(rma.env))[rma.state]"/>
                        </t>
                        <span t-if="rma.has_po_pending" class="badge rounded-pill text-bg-warning ms-1">PO Pending</span>
                        <span t-if="rma.dealer_received_date" class="badge rounded-pill text-bg-success ms-1">Received by Dealer</span>
                    </div>
                    <div class="small">
                        <div t-if="rma.inbound_awb">Inbound: <t t-out="rma.forwarder_id.name or ''"/> AWB <t t-out="rma.inbound_awb"/></div>
                        <div t-if="rma.outbound_awb">Outbound: <t t-out="rma.outbound_forwarder_id.name or ''"/> AWB <t t-out="rma.outbound_awb"/></div>
                        <div t-if="rma.po_number">PO Number: <strong t-out="rma.po_number"/>
                            <span t-if="rma.po_status == 'submitted'" class="badge rounded-pill text-bg-info ms-1">Submitted - Awaiting Verification</span>
                            <span t-elif="rma.po_status == 'verified'" class="badge rounded-pill text-bg-success ms-1">Verified</span>
                            <span t-elif="rma.po_status == 'rejected'" class="badge rounded-pill text-bg-danger ms-1">Rejected</span>
                        </div>
                    </div>
                    <div class="d-flex flex-column gap-1">
                        <a t-attf-href="/my/rma/#{rma.id}/report/reference" class="btn btn-sm btn-secondary">RMA Reference PDF</a>
                        <a t-if="rma.state in ('dispatched', 'closed')" t-attf-href="/my/rma/#{rma.id}/report/packing_list"
                           class="btn btn-sm btn-secondary">Packing List PDF</a>
                        <a t-if="rma.state in ('dispatched', 'closed')" t-attf-href="/my/rma/#{rma.id}/report/final_service"
                           class="btn btn-sm btn-secondary">Final Service Report PDF</a>
                        <a t-foreach="invoices" t-as="invoice" t-attf-href="/my/rma/#{rma.id}/report/invoice?order_id=#{invoice.id}"
                           class="btn btn-sm btn-secondary">Invoice <t t-out="invoice.name"/></a>
                    </div>
                </div>
            </div>

            <!-- Dealer acknowledgement of the returned shipment -->
            <div t-if="rma.state in ('dispatched', 'closed') and not rma.dealer_received_date" class="card mb-3 border-success">
                <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h5 class="mb-1">Have you received the devices?</h5>
                        <p class="small text-muted mb-0">Confirm once the return shipment has arrived and the devices are with you.</p>
                    </div>
                    <form t-attf-action="/my/rma/#{rma.id}/action" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="action" value="received"/>
                        <button type="submit" class="btn btn-success">Confirm Receipt</button>
                    </form>
                </div>
            </div>
            <div t-if="rma.dealer_received_date" class="alert alert-light border mb-3" role="status">
                Receipt confirmed on <span t-field="rma.dealer_received_date" t-options="{'widget': 'date'}"/>
                by <t t-out="rma.dealer_received_user_id.name"/>.
            </div>

            <!-- PO submission (CR-09): number + document in a pop-up, verified by SafeX before repair starts -->
            <t t-if="rma.has_po_pending">
                <div t-if="rma.po_status == 'submitted'" class="alert alert-info mb-3" role="status">
                    <strong>PO <t t-out="rma.po_number"/> submitted - awaiting verification.</strong>
                    SafeX is checking your Purchase Order; repair work starts once it is verified.
                </div>
                <div t-if="rma.po_status in ('none', 'rejected')" class="card mb-3 border-warning">
                    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <h5 class="mb-1">Submit your Purchase Order</h5>
                            <div t-if="rma.po_status == 'rejected'" class="alert alert-danger small mb-2" role="alert">
                                PO <strong t-out="rma.po_number"/> was not accepted<t t-if="rma.po_rejection_reason">:
                                <t t-out="rma.po_rejection_reason"/></t>. Please submit a corrected PO.
                            </div>
                            <p class="small text-muted mb-0">One PO covers the grand total of all devices. Repair
                                work starts once SafeX has verified your PO.</p>
                        </div>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                                data-bs-target="#safex_po_modal">Submit PO</button>
                    </div>
                </div>
            </t>
            <div t-elif="rma.po_status == 'verified' and rma.po_number" class="alert alert-light border mb-3" role="status">
                PO <strong t-out="rma.po_number"/> verified.
            </div>

            <div t-if="rma.has_po_pending and rma.po_status in ('none', 'rejected')" class="modal fade"
                 id="safex_po_modal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form class="modal-content" t-attf-action="/my/rma/#{rma.id}/submit_po" method="post"
                          enctype="multipart/form-data">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="modal-header"><h5 class="modal-title">Submit your Purchase Order</h5></div>
                        <div class="modal-body">
                            <label class="form-label" for="safex_po_number">PO Number</label>
                            <input type="text" id="safex_po_number" name="po_number" class="form-control mb-2"
                                   required="required" maxlength="64" placeholder="PO Number"/>
                            <label class="form-label" for="safex_po_file">PO Document (PDF or image, max 10 MB)</label>
                            <input type="file" id="safex_po_file" name="po_file" class="form-control"
                                   required="required" accept="application/pdf,image/*"/>
                            <p class="small text-muted mt-2 mb-0">The PO is sent to SafeX for verification.</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Submit PO</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Device cards -->
            <h5>Devices</h5>
            <div class="row">
                <div t-foreach="rma.line_ids" t-as="line" class="col-md-6 mb-3">
                    <div class="card h-100 o_safex_device_card">
                        <div class="card-header d-flex justify-content-between">
                            <strong><t t-out="line.product_id.name"/> - <t t-out="line.lot_id.name"/></strong>
                            <span class="badge text-bg-light" t-out="line._get_portal_state_label()"/>
                        </div>
                        <div class="card-body small">
                            <p class="mb-1"><strong>Complaint: </strong><t t-out="line.complaint_description"/></p>
                            <p t-if="line.dealer_facing_report" class="mb-1"><strong>Diagnostic: </strong><t t-out="line.dealer_facing_report"/></p>
                            <p t-if="line.rejection_reason" class="mb-1"><strong>Rejection reason: </strong><t t-out="line.rejection_reason"/></p>
                            <div>
                                <t t-foreach="rma.get_accessory_labels(line, 'acc_declared')" t-as="acc">
                                    <span class="badge text-bg-secondary me-1" t-out="acc"/>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sectioned quotation -->
            <t t-foreach="orders" t-as="order">
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between">
                        <strong>Quotation <t t-out="order.name"/></strong>
                        <a t-attf-href="/my/rma/#{rma.id}/report/quotation?order_id=#{order.id}">Download PDF</a>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr><th>Description</th><th class="text-end">Qty</th><th class="text-end">Unit Price</th><th class="text-end">Amount</th></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="order.order_line" t-as="sol">
                                    <tr t-if="sol.display_type == 'line_section'" class="table-light fw-bold">
                                        <td colspan="4">SECTION: <t t-out="sol.name"/></td>
                                    </tr>
                                    <tr t-elif="not sol.display_type">
                                        <td>
                                            <t t-out="sol.name"/>
                                            <span t-if="sol.is_spare_part" class="badge text-bg-light ms-1">Replaced part - included</span>
                                        </td>
                                        <td class="text-end" t-out="sol.product_uom_qty"/>
                                        <td class="text-end"><span t-field="sol.price_unit"/></td>
                                        <td class="text-end"><span t-field="sol.price_subtotal"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold"><td colspan="3" class="text-end">Total</td><td class="text-end"><span t-field="order.amount_total"/></td></tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </t>

            <!-- Quotation actions -->
            <div t-if="quotation_open" class="card mb-3">
                <div class="card-body">
                    <h5>Your decision</h5>
                    <div class="d-flex flex-wrap gap-2">
                        <form t-attf-action="/my/rma/#{rma.id}/action" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="action" value="approve"/>
                            <button type="submit" class="btn btn-primary">Approve Quotation</button>
                        </form>
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#safex_reject_modal">Reject a Device</button>
                        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#safex_clarify_modal">Request Clarification</button>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="safex_reject_modal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form class="modal-content" t-attf-action="/my/rma/#{rma.id}/action" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="action" value="reject"/>
                        <div class="modal-header"><h5 class="modal-title">Decline repair for a device</h5></div>
                        <div class="modal-body">
                            <label class="form-label">Device</label>
                            <select name="line_id" class="form-select mb-2" required="required">
                                <t t-foreach="rma.line_ids.filtered(lambda l: l.state in ('quoted', 'po_pending'))" t-as="line">
                                    <option t-att-value="line.id"><t t-out="line.product_id.name"/> - <t t-out="line.lot_id.name"/></option>
                                </t>
                            </select>
                            <label class="form-label">Reason (mandatory)</label>
                            <textarea name="reason" class="form-control" required="required"/>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Reject Device</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="modal fade" id="safex_clarify_modal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form class="modal-content" t-attf-action="/my/rma/#{rma.id}/action" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="action" value="clarify"/>
                        <div class="modal-header"><h5 class="modal-title">Ask the SafeX technical team</h5></div>
                        <div class="modal-body">
                            <label class="form-label">Your question (mandatory)</label>
                            <textarea name="reason" class="form-control" required="required"/>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Send</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-4">
                <h5>Communication history</h5>
                <t t-call="portal.message_thread"/>
            </div>
        </t>
    </template>

</odoo>
