<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="safex_rma_rule_portal" model="ir.rule">
        <field name="name">Portal dealer RMAs</field>
        <field name="model_id" ref="safex_rma_core.model_safex_rma"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="safex_rma_line_rule_portal" model="ir.rule">
        <field name="name">Portal dealer RMA devices</field>
        <field name="model_id" ref="safex_rma_core.model_safex_rma_line"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('rma_id.partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

</odoo>
