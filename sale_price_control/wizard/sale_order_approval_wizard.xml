<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <record id="sale_order_approval_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.approval.wizard.form</field>
        <field name="model">sale.order.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Approval Required">
                <group>
                    <field name="message"/>
                </group>
                <footer>
                    <button name="action_send_for_approval" string="Send for approval" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    </data>
</odoo>
