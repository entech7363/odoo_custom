<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_view_inherit" model="ir.ui.view">
        <field name="name">product.template.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='standard_price_uom']/field[@name='standard_price']" position="after">
                    <group col="4">

                             <field name="margin_product"/>
                            <field name="minimum_price"/>
                    </group>
            </xpath>
        </field>
    </record>
</odoo>
