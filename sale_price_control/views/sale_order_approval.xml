<odoo>
    <record id="sale_order_approval_inherited_view" model="ir.ui.view">
        <field name="name">sale.order.approval.inherited.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,to_approve,sent,sale,done</attribute>
            </xpath>


            <xpath expr="//header" position="inside">
                <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn btn-primary"
                            groups="sale_price_control.group_approval"
                            invisible="state !='to_approve'"/>

            </xpath>
            <xpath expr="//button[@name='action_confirm']" position="attributes">
                        <attribute name="invisible">context.get('state') !='to_approve'</attribute>
                        <attribute name="groups">base.group_user</attribute>
            </xpath>



        </field>
    </record>
</odoo>