<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="sales_report" inherit_id="sale.report_saleorder_document">
            <xpath expr="//tr/th[@name='th_description']" position="before">
                <t t-if="env.user.has_group('bi_order_line_with_sequence_number.access_display_order_line_number')">
                    <th name="th_d" class="text-start">No.</th>
                </t>
            </xpath>
            <xpath expr="//table[hasclass('o_main_table')]/tbody/t/tr/t/td[1]" position="before">
                <t t-if="env.user.has_group('bi_order_line_with_sequence_number.access_display_order_line_number')">
                    <td>
                        <span t-field="line.sale_sequence_number" />
                    </td>
                </t>
            </xpath>
        </template>

        <template id="purchase_report" inherit_id="purchase.report_purchaseorder_document">
            <xpath expr="//tr/th[@name='th_description']" position="before">
                <t t-if="env.user.has_group('bi_order_line_with_sequence_number.access_display_order_line_number')">
                    <th name="th_d" class="text-start">No.</th>
                </t>
            </xpath>
            <xpath expr="//table[hasclass('o_main_table')]/tbody/t/tr/t/td[1]" position="before">
                <t t-if="env.user.has_group('bi_order_line_with_sequence_number.access_display_order_line_number')">
                    <td>
                        <span t-field="line.purchase_sequence_number" />
                    </td>
                </t>
            </xpath>

        </template>
        <template id="purchase_quotation_report_inherit" inherit_id="purchase.report_purchasequotation_document">
            <xpath expr="//tr/th[@name='th_description']" position="before">
                <t t-if="env.user.has_group('bi_order_line_with_sequence_number.access_display_order_line_number')">
                    <th name="th_d" class="text-start">No.</th>
                </t>
            </xpath>
            <xpath expr="//td[@id='product']" position="before">
                <t t-if="env.user.has_group('bi_order_line_with_sequence_number.access_display_order_line_number')">
                    <td><span t-field="order_line.purchase_sequence_number" /></td></t>
            </xpath>




        </template>

        <template id="invoice_report" inherit_id="account.report_invoice_document">
            <xpath expr="//tr/th[@name='th_description']" position="before">
                <t t-if="env.user.has_group('bi_order_line_with_sequence_number.access_display_order_line_number')">
                    <th name="th_d" class="text-start">No.</th>
                </t>
            </xpath>
            <xpath expr="//table[hasclass('o_main_table')]/tbody/t/tr/t/td[1]" position="before">
                <t t-if="env.user.has_group('bi_order_line_with_sequence_number.access_display_order_line_number')">    
                    <td>
                        <span t-field="line.invoice_sequence_number" />
                    </td>
                </t>
            </xpath>
        </template>
        
    
        <template id="stock_report" inherit_id="stock.report_picking">
            <xpath expr="//table[1]/thead/tr/th[1]" position="before">
                <t t-if="env.user.has_group('bi_order_line_with_sequence_number.access_display_order_line_number')">
                    <th name="th_d" class="text-start">No.</th>
                </t>
            </xpath>
            <xpath expr="//table[1]/tbody/tr/td[1]" position="before">
                <t t-if="env.user.has_group('bi_order_line_with_sequence_number.access_display_order_line_number')">
                    <td>
                        <span t-field="ml.move_id.stock_move_sequence" />
                    </td>
                </t>
            </xpath>
        </template>
        <template id="stock_delivery_report_inheriting" inherit_id="stock.report_delivery_document">
            <xpath expr="//table[1]/thead/tr/th[1]" position="before">
                <t t-if="env.user.has_group('bi_order_line_with_sequence_number.access_display_order_line_number')">
                    <th name="th_d" class="text-start">No.</th>


                </t>
            </xpath>
            <xpath expr="//table[1]//tr[1]/td[1]" position="before">
                <t t-if="env.user.has_group('bi_order_line_with_sequence_number.access_display_order_line_number')">
                    <td>
                            <span t-esc="move.stock_move_sequence"/>
                    </td>

                </t>


           </xpath>
            <xpath expr="//table[@class='table table-borderless mt48']//thead//tr/th[1]" position="before">
    <t t-if="env.user.has_group('bi_order_line_with_sequence_number.access_display_order_line_number')">
        <th class="text-start">No.</th>


    </t>
</xpath>


        </template>

    <template id="custom_serial_number_new" inherit_id="stock.stock_report_delivery_aggregated_move_lines">

        <xpath expr="//td[1]" position="before">
            <td>
            <t t-if="'stock_move_sequence' in aggregated_lines[line]">
                <span t-esc="aggregated_lines[line]['stock_move_sequence']"/>
            </t>
        </td>

        </xpath>
    </template>

        <template id="custom_serial_number" inherit_id="stock.stock_report_delivery_has_serial_move_line">

        <xpath expr="//td[1]" position="before">
            <td>
                            <span t-esc="move_line.move_id.stock_move_sequence"/>
             </td>

        </xpath>
    </template>








        <template id="mrp_report" inherit_id="mrp.report_mrp_production_components">
            <xpath expr="//table[1]/thead/tr/th[1]" position="before">
                <th name="th_d" class="text-start">No.</th>
            </xpath>
            <xpath expr="//table[1]/tbody/tr/td[1]" position="before">
                <td>
                    <span t-field="raw_line.mrp_sequence_no" />
                </td>
            </xpath>
        </template>

        <template id="purchase_agreement_report"
            inherit_id="purchase_requisition.report_purchaserequisition_document">
            <xpath expr="//table[1]/thead/tr/th[1]" position="before">
                <th name="th_d" class="text-start">No.</th>
            </xpath>
            <xpath expr="//table[1]/tbody/tr/td[1]" position="before">
                <td>
                    <span t-field="line_id.purchase_requistion_sequence" />
                </td>
            </xpath>
        </template>

    </data>
</odoo>