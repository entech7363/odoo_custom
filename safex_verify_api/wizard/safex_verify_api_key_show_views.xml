<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="safex_verify_api_key_show_view_form" model="ir.ui.view">
        <field name="name">safex.verify.api.key.show.form</field>
        <field name="model">safex.verify.api.key.show</field>
        <field name="arch" type="xml">
            <form string="New API Key">
                <div class="alert alert-warning" role="alert">
                    Copy this key now and give it to the website developer through a secure channel.
                    It is shown only once: Odoo keeps only a hash of it. Generating a new key replaces this one.
                </div>
                <group>
                    <field name="key_id" readonly="1"/>
                    <field name="api_key" widget="CopyClipboardChar"/>
                </group>
                <footer>
                    <button name="action_close" type="object" string="I copied the key" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
