<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- API keys -->
    <record id="safex_verify_api_key_view_list" model="ir.ui.view">
        <field name="name">safex.verify.api.key.list</field>
        <field name="model">safex.verify.api.key</field>
        <field name="arch" type="xml">
            <list string="Verification API Keys">
                <field name="name"/>
                <field name="key_hint"/>
                <field name="allowed_ips"/>
                <field name="rate_limit"/>
                <field name="client_rate_limit"/>
                <field name="last_used"/>
            </list>
        </field>
    </record>

    <record id="safex_verify_api_key_view_form" model="ir.ui.view">
        <field name="name">safex.verify.api.key.form</field>
        <field name="model">safex.verify.api.key</field>
        <field name="arch" type="xml">
            <form string="Verification API Key">
                <header>
                    <button name="action_generate_key" type="object" string="Generate Key" class="btn-primary"
                            invisible="key_hint"/>
                    <button name="action_generate_key" type="object" string="Regenerate Key" invisible="not key_hint"
                            confirm="The current key stops working at once: the website must be updated with the new key. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="log_count" widget="statinfo" string="Calls"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Revoked" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="key_hint" invisible="not key_hint"/>
                            <field name="active" invisible="1"/>
                            <field name="last_used"/>
                        </group>
                        <group>
                            <field name="allowed_ips" placeholder="e.g. 203.0.113.10"/>
                            <field name="rate_limit"/>
                            <field name="client_rate_limit"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Endpoint: <code>POST /api/safex/v1/verify</code> on this database's URL, with the header
                        <code>X-SafeX-Api-Key</code>. Archive the key to revoke it.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="safex_verify_api_key_view_search" model="ir.ui.view">
        <field name="name">safex.verify.api.key.search</field>
        <field name="model">safex.verify.api.key</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Revoked" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_safex_verify_api_key" model="ir.actions.act_window">
        <field name="name">Verification API Keys</field>
        <field name="res_model">safex.verify.api.key</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an API key for the SafeX website</p>
            <p>The website's server uses it to verify devices (Serial Number + IMEI) from the public website.</p>
        </field>
    </record>

    <!-- Call log -->
    <record id="safex_verify_api_log_view_list" model="ir.ui.view">
        <field name="name">safex.verify.api.log.list</field>
        <field name="model">safex.verify.api.log</field>
        <field name="arch" type="xml">
            <list string="Verification API Calls" create="0" edit="0"
                  decoration-success="result == 'verified'" decoration-danger="result in ('unauthorized', 'forbidden_ip')"
                  decoration-warning="result == 'rate_limited'">
                <field name="create_date"/>
                <field name="key_id"/>
                <field name="remote_ip"/>
                <field name="client_ip"/>
                <field name="serial_no"/>
                <field name="result"/>
            </list>
        </field>
    </record>

    <record id="safex_verify_api_log_view_search" model="ir.ui.view">
        <field name="name">safex.verify.api.log.search</field>
        <field name="model">safex.verify.api.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="serial_no"/>
                <field name="client_ip"/>
                <field name="remote_ip"/>
                <field name="key_id"/>
                <filter name="verified" string="Verified" domain="[('result', '=', 'verified')]"/>
                <filter name="not_found" string="Not Found" domain="[('result', '=', 'not_found')]"/>
                <filter name="refused" string="Refused"
                        domain="[('result', 'in', ('unauthorized', 'forbidden_ip', 'rate_limited', 'bad_request'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_result" string="Result" context="{'group_by': 'result'}"/>
                    <filter name="group_client_ip" string="Visitor IP" context="{'group_by': 'client_ip'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_safex_verify_api_log" model="ir.actions.act_window">
        <field name="name">Verification API Calls</field>
        <field name="res_model">safex.verify.api.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_safex_verify_api" name="Website Verification API" parent="repair.repair_menu_config"
              sequence="90" groups="base.group_system"/>
    <menuitem id="menu_safex_verify_api_key" name="API Keys" parent="menu_safex_verify_api"
              action="action_safex_verify_api_key" sequence="10"/>
    <menuitem id="menu_safex_verify_api_log" name="API Calls" parent="menu_safex_verify_api"
              action="action_safex_verify_api_log" sequence="20"/>
</odoo>
