<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="report_simple_label_dymo_inherit_company"
            inherit_id="product.report_simple_label_dymo">
            <xpath expr="//div[@class='o_label_sheet o_label_dymo']" position="replace">
                <t t-if="barcode or alternative_barcode_ids">
                    <div class="o_label_sheet o_label_dymo" t-att-style="padding_page">

                        <div
                            style="padding:0; font-family: 'Roboto', sans-serif !important; margin:auto; position: relative; right:5px; margin-top: 5px !important;">

                            <t t-if="product.default_code">
                                <div
                                    style="text-align:center; font-size:10px; font-weight:bold; padding-bottom:7px;">
                                    <span t-out="product.default_code" />
                                </div>
                            </t>
                            <t t-if="barcode">
                                <!-- Barcode Image -->
                                <div t-out="barcode"
                                    style="padding:0; margin:auto;text-align:center; position: relative; bottom:12px;"
                                    t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': 'width:75px; height:16px;'}" />

                                <!-- Barcode Number -->
                                <div
                                    style="text-align:center; font-size:5px; line-height:0.1; position: relative; bottom:7px;">
                                    <!-- Barcode Code -->
                                    <span t-out="barcode"
                                        style="margin-left:7px; font-size:10px; font-weight:bold;" />
                                </div>

                            </t>
                        </div>
                    </div>

                </t>
            </xpath>
        </template>

    </data>
</odoo>