<odoo>


    <record id="paperformat_dymo_40x23" model="report.paperformat">
        <field name="name">Dymo 40x23 mm</field>
        <field name="format">custom</field>
        <field name="page_width">40</field>
        <field name="page_height">25</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>


    <record id="product.report_product_template_label_dymo" model="ir.actions.report">
        <field name="paperformat_id" ref="entech_label_custom.paperformat_dymo_40x23"/>
    </record>

    <template id="report_productlabel_dymo_custom"
              inherit_id="product.report_productlabel_dymo">
        <xpath expr="//t[@t-call='web.html_container']" position="inside">
            <style>
                .container { max-width: none !important; padding: 0 !important; margin: 0 !important; }
                body, html { margin: 0 !important; padding: 0 !important; }
                .page { padding: 0 !important; margin: 0 !important; }
                #wrapwrap { padding: 0 !important; margin: 0 !important; }
                .o_label_name, .o_label_name span,
                .o_label_full, .o_label_full span {
                    white-space: normal !important;
                    text-overflow: clip !important;
                    overflow: visible !important;
                }
            </style>
        </xpath>
    </template>


    <template id="report_simple_label_dymo_custom"
              inherit_id="product.report_simple_label_dymo">

        <!-- Replace the entire o_label_sheet wrapper -->
        <xpath expr="//div[hasclass('o_label_sheet')]" position="replace">

            <div style="
                width: 40mm;
                height: 25mm;
                padding: 1mm 1mm;
                margin: 0;
                box-sizing: border-box;
                font-family: Arial, Helvetica, sans-serif;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
            ">
                <div style="
                    font-size: 7pt;
                    font-weight: bold;
                    text-align: center;
                    width: 100%;
                    margin-bottom: 0.5mm;
                    line-height: 1.1;
                    max-height: 7.5mm;
                    overflow: hidden;
                    white-space: normal !important;
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                ">
                    <span t-field="product.default_code"/>
                    <br/>
                    <br/>
                </div>

                <!-- Barcode -->
                <t t-if="barcode">
                    <div style="text-align: center; width: 100%;">
                        <div t-out="barcode"
                             t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': 'width:36mm;height:8mm;'}"/>
                    </div>
                    <!-- Barcode Number -->
                    <div style="
                        text-align: center;
                        font-size: 8pt;
                        font-weight: bold;
                        letter-spacing: 0.5px;
                        margin-top: 0.5mm;
                        width: 100%;
                    ">
                        <span t-out="barcode"/>
                    </div>
                </t>
            </div>

        </xpath>

    </template>

</odoo>